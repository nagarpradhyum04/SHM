# StructuraSense AI backend configuration (copy to backend/.env). All keys use the SS_ prefix.
# SS_DATABASE_URL=sqlite:///./data/structurasense.db
# SS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/structurasense
# SS_STORAGE_DIR=./data/storage
# SS_MODEL_DIR=./model_store
SS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SS_MAX_UPLOAD_MB=15
# Device ingestion: per-device tokens are issued at registration. Optionally a shared key (keep secret!).
SS_DEVICE_AUTH_REQUIRED=true
# SS_DEVICE_SHARED_KEY=
SS_BACKGROUND_ENABLED=true
SS_BACKGROUND_INTERVAL_S=5
# Seed the clearly-labelled demonstration bridge and simulated data on first start.
SS_SEED_DEMO_DATA=true
SS_AUTO_MIGRATE=true
